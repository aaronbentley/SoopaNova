rules_version = '2';

/**
 * Firebase Storage rules for the uploads bucket (the project's default
 * bucket). The orders bucket isn't linked to Firebase, so clients can't
 * reach it at all.
 *
 * The browser signs in to Firebase Auth with a custom token whose uid is the
 * Clerk user id (see src/app/api/firebase/token). Uploads are named
 * `{uuid}--{uid}--{filename}`, so a user can only create and read their own
 * files: root-level JPEG/PNG up to 64MB (matches MAX_UPLOAD_FILE_SIZE).
 * Files can't be listed, overwritten or deleted by clients, and clients can't
 * set the `moderation` custom metadata - only the moderateImageUrl Cloud
 * Function writes it. Cloud Functions and the Admin SDK bypass these rules.
 */
service firebase.storage {
    match /b/{bucket}/o {
        function isOwnFile(fileName) {
            return request.auth != null
                && fileName.matches('[0-9a-f-]{36}--' + request.auth.uid + '--.+');
        }

        match /{fileName} {
            allow get: if isOwnFile(fileName);
            allow create: if isOwnFile(fileName)
                && request.resource.size < 64 * 1024 * 1024
                && request.resource.contentType.matches('image/(jpeg|png)')
                && (request.resource.metadata == null
                    || !('moderation' in request.resource.metadata));
        }
    }
}
